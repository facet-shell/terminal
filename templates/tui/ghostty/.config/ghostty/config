# Ghostty – the tui style (colors: themes/tui), written by facet theme from this template

theme = tui

font-family = JetBrains Mono
font-size = 12

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = none

# Hyprland does the blur, Ghostty only the transparency
background-opacity = 0.92
unfocused-split-opacity = 0.85

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

shell-integration = fish

# Ghostty puts fullscreen on ctrl+enter; that key belongs to the programs inside
# (Claude Code sends with it). Fullscreen stays on Super+Ctrl+F from Hyprland.
keybind = ctrl+enter=unbind

# Ctrl+Alt+Q/E type @ and € (facet/shell.lua hands Ghostty the keys as they are): a
# synthetic AltGr arrived with Ctrl and Alt still held, which a terminal reads as a control
# sequence and typed nothing
keybind = ctrl+alt+q=text:@
keybind = ctrl+alt+e=text:€
