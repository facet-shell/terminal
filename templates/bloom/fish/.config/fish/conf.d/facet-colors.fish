# facet bloom ({{name}}) – fish syntax colors. Generated by `facet theme`;
# edit templates/bloom/fish/.config/fish/conf.d/facet-colors.fish instead.
# The same roles as bloom's Zed theme: commands in the accent, strings tertiary, picks as pills.

status is-interactive; or return

set -g fish_color_normal {{tones.text|bare}}
set -g fish_color_command {{tones.primary|bare}}
set -g fish_color_keyword {{tones.primary|bare}} --bold
set -g fish_color_param {{tones.text|bare}}
set -g fish_color_option {{tones.secondary|bare}}
set -g fish_color_quote {{tones.tertiary|bare}}
set -g fish_color_redirection {{tones.secondary|bare}}
set -g fish_color_end {{tones.dim|bare}}
set -g fish_color_operator {{tones.onPrimaryContainer|bare}}
set -g fish_color_escape {{tones.secondary|bare}}
set -g fish_color_error {{tones.error|bare}}
set -g fish_color_comment {{tones.dim|mix:tones.outline:35|bare}}
set -g fish_color_autosuggestion {{tones.dim|mix:tones.outline:55|bare}}
set -g fish_color_valid_path --underline
set -g fish_color_cancel {{tones.error|bare}}
set -g fish_color_search_match --background={{tones.secondaryContainer|bare}}
set -g fish_color_selection --background={{tones.secondaryContainer|bare}}

set -g fish_pager_color_prefix {{tones.primary|bare}} --bold
set -g fish_pager_color_completion {{tones.text|bare}}
set -g fish_pager_color_description {{tones.dim|bare}}
set -g fish_pager_color_progress {{tones.dim|bare}}
set -g fish_pager_color_selected_background --background={{tones.secondaryContainer|bare}}
