# Ghostty – the bloom style (colors: themes/bloom), written by facet theme from this template

theme = bloom

# The terminal stays monospace; Rubik is only for the shell's UI text
font-family = JetBrains Mono
font-size = 12

# More air than tui: the window is one of bloom's round panels (Hyprland rounds it)
window-padding-x = 18
window-padding-y = 16
window-padding-balance = true
window-padding-color = background
window-decoration = none

# Hyprland does the blur, Ghostty only the transparency
background-opacity = 0.94
unfocused-split-opacity = 0.85

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

shell-integration = fish

# Ghostty puts fullscreen on ctrl+enter; that key belongs to the programs inside
# (Claude Code sends with it). Fullscreen stays on Super+Ctrl+F from Hyprland.
keybind = ctrl+enter=unbind
